# Copy to .env.local for local development (that file is gitignored).
# Must match apps/api's CORS_ALLOWED_ORIGINS and be reachable from the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Prototype pivot (docs/prototype-roadmap.md) — set to "true" to demo the
# prototype pages with static data and zero backend running. Leave
# unset/false for the real, API-wired pages. Either way, /login offers the
# prototype "Continue as a patient / psychologist" cards
# (docs/role-based-system-plan.md) until real sign-in is wired.
#
# This is the only variable the Vercel deployment sets, and it sets it to
# "true" — the deployed prototype has no backend to talk to. See
# docs/ci-cd/vercel-setup.md.
NEXT_PUBLIC_MOCK_MODE=false
